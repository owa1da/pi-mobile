{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,cjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,cjs,ts}"]
    },
    "packages/app": {
      "entry": [
        "babel.config.js",
        "metro.config.cjs",
        "src/app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.native.{ts,tsx}",
        "src/**/*.{ios,android,web}.{ts,tsx}",
        "plugins/*.js",
        "scripts/**/*.mjs",
        "vitest.config.{ts,js}",
        "test-stubs/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx,js,jsx}"],
      "ignore": ["src/ssh/**", "src/host/**", "modules/pi-ssh/**"]
    },
    "packages/highlight": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "patch-package",
    "buffer",
    "expo-secure-store",
    "ssh2",
    "@types/ssh2",
    "expo-updates",
    "@expo/metro-runtime",
    "metro-resolver"
  ],
  "ignoreBinaries": ["vitest"]
}
