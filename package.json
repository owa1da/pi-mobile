{
  "name": "pi-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Pi: a mobile app for managing pi coding-agent sessions over SSH (based on Paseo, Apache-2.0)",
  "keywords": [
    "coding-agent",
    "mobile",
    "ssh",
    "tmux"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Mohamed Boudra",
    "email": "hello@moboudra.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/owa1da/pi-mobile.git"
  },
  "workspaces": [
    "packages/highlight",
    "packages/app"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-patches.mjs",
    "prepare": "lefthook install --force",
    "build:highlight": "npm run build --workspace=@getpaseo/highlight",
    "build:highlight:clean": "npm run build:clean --workspace=@getpaseo/highlight",
    "build:terminal-webview": "npm run build:terminal-webview --workspace=@pi-mobile/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "start": "npm run start --workspace=@pi-mobile/app",
    "android": "npm run android --workspace=@pi-mobile/app",
    "android:development": "npm run android:development --workspace=@pi-mobile/app",
    "android:production": "npm run android:production --workspace=@pi-mobile/app",
    "android:clear": "npm run android:clear --workspace=@pi-mobile/app",
    "ios": "npm run ios --workspace=@pi-mobile/app"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "cross-env": "^10.1.0",
    "knip": "^5.82.1",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  }
}
