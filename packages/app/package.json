{
  "name": "@pi-mobile/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "eas-build-post-install": "npm --prefix ../.. run build:highlight && npm run build:terminal-webview",
    "prebuild": "npm --prefix ../.. run build:highlight",
    "android": "npm run android:development",
    "android:development": "npm run prebuild && cross-env APP_VARIANT=development expo prebuild --platform android --clean --non-interactive && cross-env APP_VARIANT=development expo run:android --variant=debug",
    "android:production": "npm run prebuild && cross-env APP_VARIANT=production expo prebuild --platform android --clean --non-interactive && cross-env APP_VARIANT=production expo run:android --variant=release",
    "android:clear": "node -e \"require('node:fs').rmSync('android', { recursive: true, force: true })\"",
    "ios": "npm run prebuild && expo run:ios",
    "web": "npm run prebuild && expo start --web",
    "lint": "expo lint",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build:terminal-webview": "node ./scripts/build-terminal-webview-html.mjs"
  },
  "dependencies": {
    "@getpaseo/highlight": "*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/react-query": "^5.90.11",
    "@xterm/addon-clipboard": "^0.3.0-beta.213",
    "@xterm/addon-fit": "^0.12.0-beta.213",
    "@xterm/addon-image": "^0.10.0-beta.213",
    "@xterm/addon-ligatures": "^0.11.0-beta.213",
    "@xterm/addon-search": "^0.17.0-beta.213",
    "@xterm/addon-unicode11": "^0.10.0-beta.213",
    "@xterm/addon-web-links": "^0.13.0-beta.213",
    "@xterm/addon-webgl": "^0.20.0-beta.212",
    "@xterm/xterm": "^6.1.0-beta.213",
    "buffer": "^6.0.3",
    "expo": "^54.0.18",
    "expo-build-properties": "^1.0.9",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "^6.0.15",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-system-ui": "~6.0.7",
    "htmlparser2": "^12.0.0",
    "i18next": "^26.3.0",
    "lucide-react-native": "^0.546.0",
    "markdown-it": "^10.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.21.12",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "0.35.5",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-uitextview": "^2.2.0",
    "react-native-unistyles": "^3.2.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "~0.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^20.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "~22.19.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/ssh2": "^1.15.6",
    "@xterm/headless": "^6.1.0-beta.213",
    "esbuild": "0.28.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-gradle-jvmargs": "^1.1.2",
    "jsdom": "^20.0.3",
    "ssh2": "^1.17.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
}
